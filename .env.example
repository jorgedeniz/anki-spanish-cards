# Copy this file as ".env" and fill it with your own credentials.

# Pictures — Pexels
PEXELS_API_KEY=your_pexels_key_here

# Text To Speech (TTS)
# Fill with the TTS provider credentials that you'll use:
# ─── SPEECH GENERATOR ───
AZURE_SPEECH_ENDPOINT="https://..."
AZURE_SPEECH_KEY_1=your_azure_speech_key_1_here
AZURE_SPEECH_KEY_2=your_azure_speech_key_2_here
AZURE_SPEECH_REGION=your_azure_speech_region_here

# ─── TRANSLATOR GENERATOR ───
AZURE_TRANSLATOR_ENDPOINT="https://..."
AZURE_TRANSLATOR_KEY_1=your_azure_translator_key_1_here
AZURE_TRANSLATOR_KEY_2=your_azure_translator_key_2_here
AZURE_TRANSLATOR_REGION=your_azure_translator_region_here